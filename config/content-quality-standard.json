  "minimum_pack_score": 85,
  "editorial_upgrade": {
    "effective_from": "2026-10-05",
    "policy_id": "huazi-editorial-v2",
    "minimum_repeat_length": 30,
    "near_repeat_similarity": 0.94,
    "opening_tension_is_advisory": true,
    "news_opening": "前120字交代可核验的新变化与读者关系；不强迫使用反差或恐吓句式",
    "fact_preservation": "编辑不得改变数字、分母、模型版本、实验条件、限定语和引用，也不得编造亲历"
  },
  "principles": [
    "前120字写清已核验的新变化及读者关系，事实切入也成立，不强造反差或焦虑",
    "一篇只保留一个核心判断和一个可辨识的绝活",
    "具体场景必须早于抽象方法论",
    "结尾直接交付一个无需互动即可执行的动作",
    "各平台按阅读场景重写，不做同文机械缩写"
  ],
  "soft_openers": [
